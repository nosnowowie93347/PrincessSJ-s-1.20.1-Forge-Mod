# Gradle build outputs and caches
.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle Wrapper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# IDE-specific files (IntelliJ IDEA, Eclipse, VS Code)
.idea/
*.iml
*.ipr
*.iws
.run/
.project
.classpath
.settings/
.vscode/

# OS-generated files
.DS_Store
Thumbs.db
